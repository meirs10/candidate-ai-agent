# Single source of local secrets/config. Copy this file to .env (gitignored) and
# fill in real values — settings.py loads .env automatically (see settings.py's
# _get()), so no manual `export` or Streamlit secrets file is needed locally.
#
# Hosted deployment only (Streamlit Community Cloud / HF Spaces): those platforms
# have no local .env — paste these same KEY = "value" lines, in TOML form, into
# the platform's own Secrets UI instead. settings.py falls back to st.secrets
# there automatically.

# Production serve path (Option A: all-API)
OPENROUTER_API_KEY=sk-or-...
VOYAGE_API_KEY=pa-...
APP_MODE=production
LLM_PROVIDER=openrouter
EMBED_PROVIDER=voyage
RERANK_PROVIDER=voyage

# ── Who can reach the recruiter chat ──
# Two independent options; pick one.
#
# (a) PUBLIC LINK + BOT CHECK (recommended for a link you send to recruiters).
#     Leave APP_PASSWORD unset and set both Turnstile keys. Nobody needs a code;
#     a Cloudflare challenge — usually invisible — keeps scripts out. Get the
#     keys from dash.cloudflare.com → Turnstile → Add site. The site key is
#     public; the secret key must stay secret and is used only to verify.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
#
# (b) PRIVATE LINK. Set APP_PASSWORD and hand the code out with the link.
# APP_PASSWORD=choose-a-shared-code
#
# With neither configured the chat is open to anyone, bots included.
# The setup page always requires APP_PASSWORD regardless.

# ── Rate limiting ──
# Sized to stop a bot flood, not to pace a recruiter — a person reads each answer
# before asking again, so these ceilings sit far above real use.
# RATE_LIMIT_ENABLED=0           # disable entirely (load testing)
# RATE_LIMIT_PER_MINUTE=12
# RATE_LIMIT_PER_HOUR=120

# ── Observability ──
# Every recruiter turn is logged with cost, latency, tools, and full text.
# Sinks: a [turn] JSON line on stdout (survives restarts on hosted platforms)
# and the JSONL file below (ephemeral when hosted).
# TELEMETRY_ENABLED=0            # turn logging off entirely
# TELEMETRY_LOG_PATH=./logs/turns.jsonl
#
# Unlocks the private usage dashboard at  ?admin=<value>  — spend, latency, and
# every conversation. MUST differ from APP_PASSWORD: that code goes to
# recruiters. Leave unset and the dashboard does not exist.
# ADMIN_PASSWORD=a-different-secret

# ── Alternative: call Claude directly instead of via OpenRouter ──
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ── To build/update the profile locally, expose the setup page: ──
# APP_MODE=setup

# ── To run the original 100%-local stack (free eval, no API): ──
# LLM_PROVIDER=ollama
# EMBED_PROVIDER=nomic
# RERANK_PROVIDER=qwen3

# ── Optional model overrides (defaults already track LLM_PROVIDER) ──
# AGENT_MODEL       = recruiter-facing answer (the only user-visible output)
# ROUTER_MODEL      = query expansion + BROAD/SPECIFIC routing + summaries
#                     (cheap per call, but they decide which chunks reach the answer)
# TOOL_SELECT_MODEL = score_tools only — the priciest call (~1,300-token fixed
#                     prompt), and the one with an escalation safety net
# AGENT_MODEL=anthropic/claude-haiku-4.5
# ROUTER_MODEL=anthropic/claude-haiku-4.5
# TOOL_SELECT_MODEL=google/gemini-2.5-flash-lite
# To A/B tool selection against the stronger model:
# TOOL_SELECT_MODEL=anthropic/claude-haiku-4.5
