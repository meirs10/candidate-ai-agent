# Single source of local secrets/config. Copy this file to .env (gitignored) and
# fill in real values — settings.py loads .env automatically (see settings.py's
# _get()), so no manual `export` or Streamlit secrets file is needed locally.
#
# Hosted deployment only (Streamlit Community Cloud / HF Spaces): those platforms
# have no local .env — paste these same KEY = "value" lines, in TOML form, into
# the platform's own Secrets UI instead. settings.py falls back to st.secrets
# there automatically.

# Production serve path (Option A: all-API)
OPENROUTER_API_KEY=sk-or-...
VOYAGE_API_KEY=pa-...
APP_PASSWORD=choose-a-shared-code
APP_MODE=production
LLM_PROVIDER=openrouter
EMBED_PROVIDER=voyage
RERANK_PROVIDER=voyage

# ── Alternative: call Claude directly instead of via OpenRouter ──
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ── To build/update the profile locally, expose the setup page: ──
# APP_MODE=setup

# ── To run the original 100%-local stack (free eval, no API): ──
# LLM_PROVIDER=ollama
# EMBED_PROVIDER=nomic
# RERANK_PROVIDER=qwen3

# ── Optional overrides (defaults already track LLM_PROVIDER) ──
# AGENT_MODEL=anthropic/claude-haiku-4.5
# ROUTER_MODEL=anthropic/claude-haiku-4.5
